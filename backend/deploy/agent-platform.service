[Unit]
Description=Agent Platform FastAPI Backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/agent-platform/backend
EnvironmentFile=/home/ubuntu/agent-platform/backend/.env
ExecStart=/home/ubuntu/agent-platform/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
